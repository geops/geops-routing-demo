{
  "name": "geops-routing-demo",
  "description": "Sample component that uses geOps Routing API",
  "version": "1.0.0",
  "homepage": "https://routing-demo.geops.io/",
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@hello-pangea/dnd": "18.0.1",
    "@mui/icons-material": "7.3.9",
    "@mui/material": "7.3.9",
    "@turf/combine": "6.5.0",
    "@turf/nearest-point-on-line": "6.5.0",
    "css-mediaquery": "0.1.2",
    "maplibre-gl": "5.20.0",
    "mobility-toolbox-js": "3.6.11",
    "ol": "10",
    "prop-types": "15.8.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-redux": "9.2.0",
    "react-spatial": "2.0.3",
    "recharts": "3.8.0",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2"
  },
  "devDependencies": {
    "@geops/eslint-config-react": "^1.6.0",
    "@testing-library/react": "16.3.2",
    "@vitejs/plugin-react": "5.1.4",
    "canvas": "3.2.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-cypress": "3.4.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mocha": "^12.0.1",
    "eslint-plugin-perfectionist": "^3.0.0",
    "eslint-plugin-prettier": "5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-vitest-globals": "^1.6.1",
    "fixpack": "4.0.0",
    "generact": "0.4.0",
    "globals": "^17.9.0",
    "husky": "8.0.3",
    "is-ci": "3.0.1",
    "jsdom": "28.1.0",
    "lint-staged": "13.2.3",
    "prettier": "3.8.1",
    "redux-mock-store": "1.5.4",
    "sass": "1.98.0",
    "stylelint": "15.10.1",
    "stylelint-config-recommended-scss": "12.0.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-scss": "5.0.1",
    "typescript-eslint": "^8.65.0",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  },
  "scripts": {
    "cp": "generact --root src/Components",
    "format": "prettier --write 'src/**/*.{js,jsx}' && eslint 'src/**/*.{js,jsx}' --fix && stylelint 'src/**/*.css' 'src/**/*.scss' --fix",
    "lint": "eslint 'src/**/*.{js,jsx}' && stylelint 'src/**/*.{css,scss}'",
    "prepare": "is-ci || husky install",
    "test": "vitest",
    "up": "pnpm upgrade-interactive --latest",
    "dev": "ESLINT_NO_DEV_ERRORS=true vite",
    "build": "vite build",
    "serve": "vite preview"
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not op_mini all",
    "not ie <= 11",
    "not android < 5"
  ],
  "pnpm": {
    "overrides": {
      "rolldown": "1.1.3"
    },
    "onlyBuiltDependencies": [
      "canvas",
      "chromium",
      "core-js",
      "cypress",
      "esbuild",
      "sharp"
    ]
  },
  "keywords": [
    "demo",
    "geops",
    "gis",
    "openlayers",
    "routing"
  ],
  "license": "MIT",
  "lint-staged": {
    "src/lang/*.json": [
      "pnpm sort"
    ],
    "(src|__mocks__)/**/*.js": [
      "eslint --fix",
      "prettier --write",
      "pnpm test --bail --related"
    ],
    "package.json": [
      "fixpack --sortToTop name --sortToTop description --sortToTop main --sortToTop version --sortToTop private --sortToTop homepage --sortToTop dependencies --sortToTop peerDependencies --sortToTop devDependencies --sortToTop scripts"
    ],
    "src/**/*.{css,scss}": [
      "stylelint --fix"
    ]
  },
  "prettier": {
    "trailingComma": "all",
    "singleQuote": true,
    "arrowParens": "always"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geops/geops-routing-demo.git"
  },
  "stylelint": {
    "plugins": [
      "stylelint-scss"
    ],
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-recommended-scss"
    ],
    "rules": {
      "selector-pseudo-class-no-unknown": [
        true,
        {
          "ignorePseudoClasses": [
            "export"
          ]
        }
      ],
      "property-no-unknown": [
        true,
        {
          "ignoreProperties": [
            "/^brandprimary/",
            "/gray/"
          ]
        }
      ]
    }
  },
  "packageManager": "pnpm@10.30.3"
}
